# ─────────────────────────────────────────────────────────────
# Configuración del backend Golden Cat
# Copia este archivo como  .env  y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor HTTP
PORT=8000

# URL pública del backend (usada para construir las URLs de las imágenes)
PUBLIC_URL=http://localhost:8000

# ── Base de datos ────────────────────────────────────────────
# Dialecto: "sqlite" (por defecto, sin configuración) o "mysql"
DB_DIALECT=sqlite

# Solo para SQLite: ruta del archivo de base de datos
# DB_STORAGE=./data/golden-cat.sqlite

# Solo para MySQL:
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=golden_cat
# DB_USER=root
# DB_PASS=secret

# Mostrar en consola las consultas SQL (true/false)
DB_LOGGING=false

# Carpeta donde se guardan las imágenes subidas
# UPLOAD_DIR=./uploads
